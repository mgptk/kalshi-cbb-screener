# Copy into Community Cloud's "Secrets" box (App settings -> Secrets).

# A hosted container has no browser, so the sportsbook boards and KenPom
# cannot be scraped there. false stops the app trying.
browser_scrapes = false

# With no browser, the books come from The Odds API instead: the same
# DraftKings and BetMGM lines over plain HTTPS. Sign up at
# https://the-odds-api.com - the free tier is 500 credits a month and this
# board spends one per refresh. Without a key the board still runs, but with
# no book prices, no composite and no Edge.
odds_api_key = "your-key-here"
