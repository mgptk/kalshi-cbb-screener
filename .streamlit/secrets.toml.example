# Copy into Community Cloud's "Secrets" box (App settings -> Secrets).

# A hosted container has no browser, so the sportsbook boards cannot be
# scraped there. false stops the app trying.
browser_scrapes = false

# Where the book prices come from. One request covers every US book The Odds
# API carries - eight at the last count, DraftKings and BetMGM among them -
# and costs one credit, so the free tier's 500 a month is about sixteen
# refreshes a day. Sign up at https://the-odds-api.com. Without a key the
# board still runs, but with no book prices, no composite and no Edge.
odds_api_key = "your-key-here"
